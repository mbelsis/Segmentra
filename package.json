{
  "name": "segmentra",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/api",
    "build": "npm run build -w @segmentra/shared && npm run build:self -w @segmentra/compiler && npm run build -w @segmentra/executor && npm run build:self -w @segmentra/api && npm run build -w web",
    "db:migrate": "npm run migrate:up -w @segmentra/db",
    "db:seed": "npm run seed -w @segmentra/db",
    "db:demo": "node packages/db/scripts/load-demo.js",
    "lint": "npm run lint --workspaces --if-present",
    "test:integration:ssh-docker": "node ./tests/run-docker-ssh-integration.mjs",
    "test:security": "npm run build -w @segmentra/api && node --test tests/security-regressions.test.mjs",
    "test:firewall-managers": "npm run build -w @segmentra/api && node --test tests/native-firewall.test.mjs",
    "test:integration:firewall-managers": "npm run build -w @segmentra/api && node tests/run-native-firewall-integration.mjs",
    "test:integration:k8s": "node tests/k8s-integration/run.mjs",
    "test:k8s-auth": "npm run build -w @segmentra/api && node --test tests/k8s-cloud-auth.test.mjs",
    "test:swarm-compile": "npm run build -w @segmentra/compiler && node --test tests/swarm-compile.test.mjs",
    "test:integration:swarm": "npm run build && node tests/swarm-lab/run.mjs",
    "test:integration:policy-code": "node tests/policy-as-code/run.mjs",
    "test:integration:compliance": "node tests/compliance-report/run.mjs",
    "test:integration:iot": "node tests/iot/run.mjs",
    "test:integration:ot-gateway": "node tests/ot-gateway-lab/run.mjs",
    "test:integration:expiry": "node tests/expiry-lab/run.mjs",
    "test:integration:expiry-matrix": "node tests/expiry-lab/matrix/matrix.mjs",
    "test:lab:base": "node tests/labs/run.mjs base",
    "test:lab:iot": "node tests/labs/run.mjs iot",
    "test:lab:swarm": "node tests/labs/run.mjs swarm",
    "test:lab:k8s": "node tests/labs/run.mjs k8s",
    "test:unit:iot": "node --test tests/iot-helpers.test.mjs",
    "test:installers": "node --test tests/installers.test.mjs",
    "test:audit-r4": "npm run build && node --test tests/audit-r4-compiler.test.mjs tests/audit-r4-deployments.test.mjs tests/audit-r4-executor.test.mjs tests/audit-r4-security.test.mjs tests/audit-r4-sessions.test.mjs",
    "test:audit-r5": "npm run build && node --test tests/audit-r5-analysis.test.mjs tests/audit-r5-api.test.mjs tests/audit-r5-executor.test.mjs tests/audit-r5-infra.test.mjs tests/audit-r5-inventory.test.mjs tests/audit-r5-k8s-pac.test.mjs",
    "test:review-fixes": "npm run build -w @segmentra/api && node --test tests/review-fixes.test.mjs",
    "test:integration:review-fixes": "node tests/review-fixes/run.mjs",
    "test:integration:race": "node tests/review-fixes/race.mjs",
    "test:integration:sessions": "npm run build && node tests/review-fixes/sessions.mjs",
    "test:integration:round3": "npm run build && node tests/review-fixes/round3.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbelsis/Segmentra.git"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/mbelsis/Segmentra/issues"
  },
  "homepage": "https://github.com/mbelsis/Segmentra#readme"
}
